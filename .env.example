NODE_ENV=development
PORT=3000
SUPPORTED_CHAINS=ethereum,base,arbitrum,polygon

# PostgreSQL. Use the pooled URL for application queries and the direct URL only for migrations.
DATABASE_URL=postgresql://user:password@pooler.example.com:6543/database
DATABASE_URL_UNPOOLED=postgresql://user:password@database.example.com:5432/database
DATABASE_POOL_MAX=5
RPC_TIMEOUT_MS=10000
RPC_RETRIES=1
ETHERSCAN_API_KEY=

# Telegram is optional. Leave the token empty to disable the bot.
TELEGRAM_BOT_TOKEN=

# Discord is optional. Configure all three values to enable the development bot
# and immediate guild-scoped slash-command registration.
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_DEV_GUILD_ID=

# Optional social watcher adapters. Credentials are environment-only and never stored in watch-rule config.
SOCIAL_OFFICIAL_API_URL=
SOCIAL_OFFICIAL_API_TOKEN=
SOCIAL_MANAGED_SERVICE_URL=
SOCIAL_MANAGED_SERVICE_TOKEN=
SOCIAL_POLL_INTERVAL_MS=30000

# These values satisfy development-mode validation only. Never use them in production.
ENCRYPTION_SECRET=dev-encryption-key-7Qv9!m2Lx4Rk8Zp3Cw6N
ENCRYPTION_KEY_VERSION=1
ENCRYPTION_OLD_KEYS={}

# Optional RPC overrides. The application uses public defaults when omitted.
ETH_RPC=
BASE_RPC=
ARB_RPC=
POLYGON_RPC=

# Optional comma-separated failover endpoints. When set, these take precedence over the matching single URL above.
ETH_RPC_URLS=
BASE_RPC_URLS=
ARB_RPC_URLS=
POLYGON_RPC_URLS=
