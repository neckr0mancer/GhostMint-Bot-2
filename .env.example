NODE_ENV=development
PORT=3000

# Telegram is optional. Leave TELEGRAM_BOT_TOKEN empty to disable the bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Replace these development placeholders before running the application.
# Strict production validation is intentionally deferred to Milestone 2.
ENCRYPTION_SECRET=replace-with-a-long-random-secret
DASHBOARD_PASSWORD=replace-with-a-strong-password

# Optional RPC overrides. The application uses public defaults when omitted.
ETH_RPC=
BASE_RPC=
ARB_RPC=
POLYGON_RPC=

