NODE_ENV=development
PORT=3000
SUPPORTED_CHAINS=ethereum,base,arbitrum,polygon

# PostgreSQL. Use the pooled URL for application queries and the direct URL only for migrations.
DATABASE_URL=postgresql://user:password@pooler.example.com:6543/database
DATABASE_URL_UNPOOLED=postgresql://user:password@database.example.com:5432/database
DATABASE_POOL_MAX=5

# Telegram is optional. Leave both values empty to disable the bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# These values satisfy development-mode validation only. Never use them in production.
ENCRYPTION_SECRET=dev-encryption-key-7Qv9!m2Lx4Rk8Zp3Cw6N
ENCRYPTION_KEY_VERSION=1
ENCRYPTION_OLD_KEYS={}
DASHBOARD_PASSWORD=dev-dashboard-9Nf4!Tq7Vx2Jm8Kp

# Optional RPC overrides. The application uses public defaults when omitted.
ETH_RPC=
BASE_RPC=
ARB_RPC=
POLYGON_RPC=
