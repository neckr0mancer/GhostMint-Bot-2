NODE_ENV=development
PORT=3000
SUPPORTED_CHAINS=ethereum,base,arbitrum,polygon

# PostgreSQL. Use the pooled URL for application queries and the direct URL only for migrations.
DATABASE_URL=postgresql://user:password@pooler.example.com:6543/database
DATABASE_URL_UNPOOLED=postgresql://user:password@database.example.com:5432/database
DATABASE_POOL_MAX=5
RPC_TIMEOUT_MS=10000
RPC_RETRIES=1

# Optional. How long before a scheduled mint's fire moment the scheduler runs its preparation
# pass (account status, wallet resolution, SeaDrop discovery warm-up -- checks and lookups whose
# results cannot go stale; calldata and price are still built fresh at fire time). 0 (default)
# disables pre-arming entirely. A recommended production value is 12000.
SCHEDULE_PREARM_LEAD_MS=

# Bump ladder (stuck-transaction recovery). A pending broadcast stuck this long gets re-bid
# same-nonce at +increment% (floored by live fees, capped by the wallet's governance gas ceiling),
# at most max-attempts times, for these comma-separated trigger sources.
TX_BUMP_AFTER_MS=45000
TX_BUMP_INCREMENT_PCT=15
TX_BUMP_MAX_ATTEMPTS=3
TX_BUMP_SOURCES=launch,scheduled
ETHERSCAN_API_KEY=

# Optional. Get a key from OpenSea's developer portal (https://docs.opensea.io/reference/api-keys).
# Used for collection metadata/stats/phase display, OpenSea link resolution, and OpenSea-backed
# mint execution (POST /drops/{slug}/mint for allowlist/GTD/FCFS stages). Leave empty to disable;
# contract detection still works via on-chain reads alone, just without OpenSea's own data/minting.
OPENSEA_API_KEY=

# Optional. A SEPARATE OpenSea account's key (not just a second key on the same account -- OpenSea
# pools its rate limit per account regardless of key count, so a second key on the same account
# buys nothing). Routes read/display calls here (getDrop, getCollectionMetadata, getCollectionStats
# -- now hit on every paste, not just /info) so a rate-limit hit on that side can never touch
# OPENSEA_API_KEY's account, which is what actually executes real mints. Leave empty to keep read
# traffic on OPENSEA_API_KEY, zero behavior change.
OPENSEA_READ_API_KEY=

# Telegram is optional. Leave the token empty to disable the bot.
TELEGRAM_BOT_TOKEN=

# Discord is optional. Set the token and application ID together to enable the bot.
# DISCORD_DEV_GUILD_ID is optional and turns it into a *development* bot: slash commands
# register to that one guild (instant, where global registration can take up to an hour to
# propagate) and every command is refused anywhere else, DMs included. Leave it empty for a
# normal bot that serves every server it is added to, plus DMs. Startup clears any guild-scoped
# commands left behind by a previous dev guild, so switching back and forth does not duplicate them.
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_DEV_GUILD_ID=
# Optional comma-separated channel snowflakes. When set, the bot only answers slash commands and
# paste-to-mint in those channels -- independent of DISCORD_DEV_GUILD_ID, so it works for a bot
# serving many servers. DMs are never filtered by this. Empty means every channel it can see.
DISCORD_CHANNEL_IDS=

# Optional social watcher adapters. Credentials are environment-only and never stored in watch-rule config.
SOCIAL_OFFICIAL_API_URL=
SOCIAL_OFFICIAL_API_TOKEN=
SOCIAL_MANAGED_SERVICE_URL=
SOCIAL_MANAGED_SERVICE_TOKEN=
SOCIAL_POLL_INTERVAL_MS=30000

# These values satisfy development-mode validation only. Never use them in production.
ENCRYPTION_SECRET=dev-encryption-key-7Qv9!m2Lx4Rk8Zp3Cw6N
ENCRYPTION_KEY_VERSION=1
ENCRYPTION_OLD_KEYS={}

# Optional RPC overrides. The application uses public defaults when omitted.
ETH_RPC=
BASE_RPC=
ARB_RPC=
POLYGON_RPC=
ROBINHOOD_RPC=

# Sepolia is a testnet, only relevant if SUPPORTED_CHAINS includes it for a
# Milestone 14 live acceptance run (see docs/LIVE_ACCEPTANCE_RUNBOOK.md).
SEPOLIA_RPC=

# Optional comma-separated failover endpoints. When set, these take precedence over the matching single URL above.
# Hard cap: 1-5 UNIQUE urls per pool -- config throws at boot beyond that (this is what crashed
# production on 2026-08-22 when lane wiring appended past the cap; count before you write).
ETH_RPC_URLS=
BASE_RPC_URLS=
ARB_RPC_URLS=
POLYGON_RPC_URLS=
ROBINHOOD_RPC_URLS=
SEPOLIA_RPC_URLS=

# Optional per-chain WebSocket RPC endpoints. Unused unless a feature needs a live subscription;
# plain HTTP polling via the URLs above is sufficient otherwise.
ETH_RPC_WS=
BASE_RPC_WS=
ARB_RPC_WS=
POLYGON_RPC_WS=
ROBINHOOD_RPC_WS=
SEPOLIA_RPC_WS=

# Optional scheduled/Degen fast pool (Round 15): prepended ahead of that chain's
# {CHAIN}_RPC_URLS as automatic fallback; unset means the fast pool IS the general pool.
# Used for pre-broadcast reads on time-critical scheduled/Degen mints only.
ETH_RPC_FAST_URLS=
BASE_RPC_FAST_URLS=
ARB_RPC_FAST_URLS=
POLYGON_RPC_FAST_URLS=
ROBINHOOD_RPC_FAST_URLS=

# Optional sniper-only pool (Round 16): isolated from both the general pool and the
# scheduled/Degen fast pool so continuous sniper polling can never share a rate-limit
# bucket with a time-critical broadcast. The WS URL powers the chain watcher's live push.
ETH_RPC_SNIPER_URLS=
BASE_RPC_SNIPER_URLS=
ARB_RPC_SNIPER_URLS=
POLYGON_RPC_SNIPER_URLS=
ROBINHOOD_RPC_SNIPER_URLS=
ETH_RPC_SNIPER_WS=
BASE_RPC_SNIPER_WS=
ARB_RPC_SNIPER_WS=
POLYGON_RPC_SNIPER_WS=
ROBINHOOD_RPC_SNIPER_WS=

# Only needed when running scripts/clear-non-owner-users.js, scripts/clear-all-users.js, or
# scripts/merge-duplicate-account.js by hand; never set these in a deployed environment.
CLEAR_CONFIRM=
CLEAR_ALL_CONFIRM=
MERGE_CONFIRM=
MERGE_SOURCE_PLATFORM=
MERGE_SOURCE_PLATFORM_USER_ID=
MERGE_TARGET_PLATFORM=
MERGE_TARGET_PLATFORM_USER_ID=

# Milestone 14 live testnet acceptance run parameters. Only needed when running
# scripts/live-acceptance-run.js by hand; never set these in a deployed environment.
# See docs/LIVE_ACCEPTANCE_RUNBOOK.md for the full procedure. The wallet must already
# be onboarded through the normal encrypted wallet flow; never put a raw private key here.
LIVE_ACCEPTANCE_CONFIRM=
LIVE_ACCEPTANCE_OPERATOR_USER_ID=
LIVE_ACCEPTANCE_CHAIN=
LIVE_ACCEPTANCE_WALLET_ID=
LIVE_ACCEPTANCE_CONTRACT_ADDRESS=
LIVE_ACCEPTANCE_METHOD_SIGNATURE=
LIVE_ACCEPTANCE_VALUE_WEI=
