{
  "name": "ghostmint-server",
  "version": "2.0.0",
  "description": "GhostMint 24/7 NFT minting bot",
  "private": true,
  "packageManager": "npm@11.7.0",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "check": "node --check index.js && node --check src/config/index.js && node --check src/server.js && node --check tests/config.test.js && node --check tests/smoke.test.js",
    "lint": "eslint .",
    "test": "node --test",
    "validate": "npm run check && npm run lint && npm test"
  },
  "dependencies": {
    "ethers": "^6.7.0",
    "express": "^4.18.2",
    "node-telegram-bot-api": "^1.2.0",
    "crypto-js": "^4.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "axios": "^1.6.0"
  },
  "devDependencies": {
    "eslint": "^9.39.1"
  },
  "engines": {
    "node": "24.x"
  }
}
